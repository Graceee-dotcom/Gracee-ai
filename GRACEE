                            <span>${msg.timestamp}</span>
                        </div>
                        <div class="msg-content text-sm text-slate-200 leading-relaxed glass-card p-4 rounded-2xl border border-white/5">
                            ${msg.loading ? '<div class="flex items-center gap-2 text-slate-400 font-mono text-xs"><i class="fa-solid fa-circle-notch fa-spin"></i> Reasoning...</div>' : marked.parse(msg.content)}
                        </div>
                    </div>
                `;
            } else {
                let attachmentHTML = '';
                if (msg.attachments && msg.attachments.length > 0) {
                    attachmentHTML = `<div class="flex gap-2 mb-2">` + msg.attachments.map(a => `<span class="px-2 py-1 rounded bg-white/10 text-[10px] font-mono text-slate-300"><i class="fa-solid fa-file mr-1"></i>${a.name}</span>`).join('') + `</div>`;
                }

                msgEl.innerHTML = `
                    <div class="max-w-xl space-y-1">
                        <div class="text-right text-[10px] font-mono text-slate-500">${msg.timestamp}</div>
                        <div class="glass-panel bg-slate-200/10 text-slate-100 text-sm p-4 rounded-2xl border border-white/10">
                            ${attachmentHTML}
                            <div>${escapeHTML(msg.content)}</div>
                        </div>
                    </div>
                `;
            }

            container.appendChild(msgEl);
            hljs.highlightAll();
        }

        function updateAssistantMessageUI(msgId, contentText) {
