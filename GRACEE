        /* ==================================================== */
        /* 06. GEMINI CENTRAL INTELLIGENCE API CALL & CHAT      */
        /* ==================================================== */
        async function handleUserMessageSubmit() {
            const prompt = DOM.chatUserInput.value.trim();
            if (!prompt && AppState.attachments.length === 0) return;

            // Hide empty state if visible
            DOM.emptyState.classList.add('hidden');

            // Construct user message object
            const userMsg = {
                id: crypto.randomUUID(),
                sender: 'user',
                content: prompt,
                attachments: [...AppState.attachments],
                timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
            };

            // Reset input bar
            DOM.chatUserInput.value = '';
            AppState.attachments = [];
            renderAttachmentPreviews();

            // Append user message to UI
            appendMessageToUI(userMsg);
            AppState.messages.push(userMsg);

            // Create placeholder assistant message with pulsing loading state
            const assistantMsgId = crypto.randomUUID();
            const assistantMsg = {
                id: assistantMsgId,
                sender: 'assistant',
                content: '',
                loading: true,
                timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
            };
            appendMessageToUI(assistantMsg);
            scrollToBottom();

            // Execute Gemini API call
            try {
                const responseText = await callGeminiAPI(prompt, userMsg.attachments);
                updateAssistantMessageUI(assistantMsgId, responseText);
            } catch (err) {
                console.error("Gemini API Error:", err);
                updateAssistantMessageUI(assistantMsgId, `**System Error:** Unable to reach Gemini API backend. (${err.message || 'Check network connection'})`);
            }
        }

        async function callGeminiAPI(userQuery, attachments) {
            // Setup model and API payload using standard gemini-3-flash-preview endpoint
            const modelName = "gemini-3-flash-preview";
            const apiKey = AppState.apiKey; // Will fall back to empty string allowing environment injection
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/${modelName}:generateContent?key=${apiKey}`;

            // Build system memory instructions
            const memoryDirective = AppState.memoryNotes.length > 0 
                ? "User Preferences & Memory Context:\n" + AppState.memoryNotes.map(n => `- ${n}`).join("\n")
                : "";

            const systemInstructionText = `You are GRACEE AI, an elite, highly intelligent, cinematic AI assistant. Answer with structured markdown, concise logic, high quality code blocks, and professional depth. ${memoryDirective}`;

            // Build parts
            const parts = [];
            
            // Handle image/file inline attachments
            if (attachments && attachments.length > 0) {
                for (const att of attachments) {
                    if (att.mimeType.startsWith('image/')) {
                        parts.push({
                            inlineData: {
                                mimeType: att.mimeType,
                                data: att.base64
                            }
                        });
                    } else {
                        // Text document prepending
                        parts.push({ text: `[Attached Document ${att.name}]:\n${att.textData}\n\n` });
                    }
                }
            }

            parts.push({ text: userQuery });

            const payload = {
                contents: [{ parts: parts }],
                systemInstruction: {
                    parts: [{ text: systemInstructionText }]
                }
            };

            // Grounding check
            if (DOM.toggleSearchGrounding.checked) {
                payload.tools = [{ "google_search": {} }];
            }

            const response = await fetch(apiUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                const errorBody = await response.json().catch(() => ({}));
                throw new Error(errorBody.error?.message || `HTTP ${response.status}`);
            }

            const result = await response.json();
            const candidate = result.candidates?.[0];
            let outputText = candidate?.content?.parts?.[0]?.text || "No response received from Gemini engine.";

            // Format search grounding sources if returned
            if (candidate?.groundingMetadata?.groundingAttributions) {
                const sources = candidate.groundingMetadata.groundingAttributions
                    .map(att => att.web?.uri ? `-[${att.web.title || att.web.uri}](${att.web.uri})` : null)
                    .filter(Boolean);
                if (sources.length > 0) {
                    outputText += `\n\n### Web Sources\n` + sources.join('\n');
                }
            }

            return outputText;
        }

