        /* ==================================================== */
        /* 01. CINEMATIC INTRO CANVAS & ANIMATION SEQUENCE      */
        /* ==================================================== */
        function initCinematicIntroAnimation() {
            const canvas = DOM.introCanvas;
            const ctx = canvas.getContext('2d');
            let width, height;
            let particles = [];

            function resize() {
                width = canvas.width = window.innerWidth;
                height = canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resize);
            resize();

            // Create atmospheric particle field
            for (let i = 0; i < 80; i++) {
                particles.push({
                    x: Math.random() * width,
                    y: Math.random() * height,
                    radius: Math.random() * 1.5 + 0.5,
                    vx: (Math.random() - 0.5) * 0.3,
                    vy: (Math.random() - 0.5) * 0.3,
                    alpha: Math.random() * 0.5 + 0.1
                });
            }

            function renderParticles() {
                ctx.clearRect(0, 0, width, height);
                ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
                
                particles.forEach(p => {
                    p.x += p.vx;
                    p.y += p.vy;
                    if (p.x < 0) p.x = width;
                    if (p.x > width) p.x = 0;
                    if (p.y < 0) p.y = height;
                    if (p.y > height) p.y = 0;

                    ctx.beginPath();
                    ctx.globalAlpha = p.alpha;
                    ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                    ctx.fill();
                });
                requestAnimationFrame(renderParticles);
            }
            renderParticles();

            // Timed sequence for kinetic typography and centerpiece reveal
            setTimeout(() => {
                DOM.introLogoContainer.classList.remove('opacity-0', 'scale-90');
                DOM.introLogoContainer.classList.add('opacity-100', 'scale-100');
            }, 300);

            setTimeout(() => {
                DOM.introTitle.classList.remove('opacity-0', 'translate-y-6');
                DOM.introTitle.classList.add('opacity-100', 'translate-y-0');
            }, 700);

            setTimeout(() => {
                DOM.introSubtitle.classList.remove('opacity-0', 'translate-y-6');
                DOM.introSubtitle.classList.add('opacity-100', 'translate-y-0');
            }, 1000);

            setTimeout(() => {
                DOM.introActionContainer.classList.remove('opacity-0', 'translate-y-6');
                DOM.introActionContainer.classList.add('opacity-100', 'translate-y-0');
            }, 1300);
        }

