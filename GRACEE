<!DOCTYPE html>
<html lang="en" class="dark h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>GRACEE AI — Ultimate Premium AI Platform</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f4f4f6',
                            100: '#e6e7eb',
                            200: '#cfd1d9',
                            300: '#abafbe',
                            400: '#7e849b',
                            500: '#5e637a',
                            600: '#4a4e62',
                            700: '#3c3f50',
                            800: '#343644',
                            900: '#2d2e3a',
                            950: '#0a0a0c',
                        },
                        charcoal: {
                            DEFAULT: '#121316',
                            light: '#1a1c20',
                            border: '#2a2d34'
                        },
                        accent: {
                            silver: '#e2e8f0',
                            glow: '#00f2fe',
                            violet: '#7928ca'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'Fira Code', 'monospace']
                    },
                    animation: {
                        'pulse-glow': 'pulseGlow 3s infinite ease-in-out',
                        'float': 'float 6s infinite ease-in-out',
                        'spin-slow': 'spin 12s linear infinite',
                    },
                    keyframes: {
                        pulseGlow: {
                            '0%, 100%': { opacity: '0.4', filter: 'blur(10px)' },
                            '50%': { opacity: '0.8', filter: 'blur(20px)' },
                        },
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-10px)' },
                        }
                    }
                }
            }
        }
    </script>

    <!-- FontAwesome & Google Fonts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- Markdown Parser (Marked) & Highlight.js -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.7.0/styles/atom-one-dark.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.7.0/highlight.min.js"></script>

    <style>
        /* Custom Styling for Cinematic Depth */
        body {
            background-color: #050505;
            color: #f8fafc;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
            touch-action: manipulation;
        }

        /* Glassmorphism Surface */
        .glass-panel {
            background: rgba(18, 19, 22, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .glass-card {
            background: rgba(26, 28, 32, 0.6);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.06);
        }

        .glass-input {
            background: rgba(10, 10, 12, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(8px);
        }
        .glass-input:focus {
            border-color: rgba(226, 232, 240, 0.4);
            box-shadow: 0 0 15px rgba(255, 255, 255, 0.05);
        }

        /* Custom Scrollbars */
        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        ::-webkit-scrollbar-track {
            background: #0a0a0c;
        }
        ::-webkit-scrollbar-thumb {
            background: #2a2d34;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #4a4e62;
        }

        /* Animated Gradient Background */
        .gradient-glow {
            background: radial-gradient(circle at 50% 50%, rgba(0, 242, 254, 0.08), rgba(121, 40, 202, 0.05), transparent 70%);
        }

        /* Hide scrollbars for slick UX */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="h-full antialiased selection:bg-slate-700 selection:text-white">

    <div id="app" class="relative w-full h-full min-h-screen flex flex-col overflow-hidden">

        <!-- ========================================== -->
        <!-- 01 & 02. CINEMATIC INTRODUCTION & CANVAS   -->
        <!-- ========================================== -->
        <div id="intro-screen" class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-black transition-opacity duration-1000">
            <!-- Canvas background for dynamic atmospheric particles & WebGL-style depth -->
            <canvas id="intro-canvas" class="absolute inset-0 w-full h-full pointer-events-none"></canvas>
            
            <!-- Glow background circle -->
            <div class="absolute w-[500px] h-[500px] rounded-full gradient-glow animate-pulse-glow pointer-events-none"></div>

            <div class="relative z-10 flex flex-col items-center text-center px-6 max-w-xl">
                <!-- Abstract Centerpiece Logo -->
                <div id="intro-logo-container" class="relative mb-8 transform transition-all duration-1000 scale-90 opacity-0">
                    <div class="w-24 h-24 rounded-2xl glass-panel flex items-center justify-center relative overflow-hidden shadow-2xl border border-white/20">
                        <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500/20 to-purple-600/20 animate-spin-slow"></div>
                        <i class="fa-solid fa-brain text-4xl text-slate-100 drop-shadow-[0_0_15px_rgba(255,255,255,0.6)]"></i>
                    </div>
                    <!-- Outer metallic ring -->
                    <div class="absolute -inset-2 rounded-2xl border border-white/10 animate-ping opacity-25"></div>
                </div>

                <!-- Animated Title -->
                <h1 id="intro-title" class="text-3xl sm:text-5xl font-light tracking-[0.25em] text-white uppercase mb-3 transform transition-all duration-1000 translate-y-6 opacity-0">
                    GRACEE <span class="font-bold text-transparent bg-clip-text bg-gradient-to-r from-slate-100 via-slate-300 to-slate-500">AI</span>
                </h1>
                
                <p id="intro-subtitle" class="text-xs sm:text-sm font-light tracking-[0.2em] text-slate-400 uppercase mb-8 transform transition-all duration-1000 translate-y-6 opacity-0">
                    Ultimate Premium Intelligence Ecosystem
                </p>

                <!-- Enter Platform Trigger / Google Auth Launch -->
                <div id="intro-action-container" class="transform transition-all duration-1000 translate-y-6 opacity-0 w-full max-w-xs space-y-3">
                    <button id="btn-begin-auth" class="w-full py-4 px-6 rounded-xl glass-panel text-slate-100 font-medium tracking-wider text-xs uppercase border border-white/20 hover:border-white/50 transition-all duration-300 hover:shadow-[0_0_25px_rgba(255,255,255,0.15)] flex items-center justify-center gap-3 group">
                        <i class="fa-brands fa-google text-slate-300 group-hover:scale-110 transition-transform"></i>
                        <span>Continue with Google</span>
                    </button>
                    
                    <button id="btn-guest-access" class="w-full py-2.5 px-4 text-slate-400 hover:text-slate-200 text-xs tracking-widest uppercase transition-colors">
                        Explore Platform Mode
                    </button>
                </div>
            </div>

            <!-- Footer info -->
            <div class="absolute bottom-6 text-[10px] text-slate-600 uppercase tracking-widest font-mono">
                Powered by Google Gemini API &bull; Supabase RLS Protected
            </div>
        </div>

        <!-- ========================================== -->
        <!-- 03. AUTHENTICATION MODAL (GOOGLE OAUTH)    -->
        <!-- ========================================== -->
        <div id="auth-modal" class="fixed inset-0 z-40 hidden flex items-center justify-center bg-black/80 backdrop-blur-md p-4 transition-all duration-500">
            <div class="glass-panel w-full max-w-md rounded-2xl p-6 sm:p-8 border border-white/10 shadow-2xl relative overflow-hidden">
                <div class="absolute top-0 right-0 p-4">
                    <button id="btn-close-auth" class="text-slate-400 hover:text-white transition-colors">
                        <i class="fa-solid fa-xmark text-lg"></i>
                    </button>
                </div>

                <div class="text-center mb-6">
                    <div class="w-12 h-12 rounded-xl glass-card flex items-center justify-center mx-auto mb-3 border border-white/10">
                        <i class="fa-brands fa-google text-xl text-slate-200"></i>
                    </div>
                    <h2 class="text-xl font-medium tracking-wide text-white">Google OAuth Authentication</h2>
                    <p class="text-xs text-slate-400 mt-1">Secure Sign-In for GRACEE AI Ecosystem</p>
                </div>

                <!-- OAuth Configuration Details -->
                <div class="space-y-4">
                    <div class="p-4 rounded-xl bg-charcoal-light/60 border border-white/5 text-xs text-slate-300 space-y-2 font-mono">
                        <div class="flex justify-between items-center text-slate-400">
                            <span>Provider:</span>
                            <span class="text-emerald-400 font-bold">Supabase OAuth</span>
                        </div>
                        <div class="flex justify-between items-center text-slate-400">
                            <span>Redirect Target:</span>
                            <span class="text-slate-200">/auth/v1/callback</span>
                        </div>
                        <div class="flex justify-between items-center text-slate-400">
                            <span>Session Persistence:</span>
                            <span class="text-cyan-400">Encrypted JWT</span>
                        </div>
                    </div>

                    <!-- Email Input for Simulation / Verification -->
                    <div>
                        <label class="block text-xs font-mono uppercase tracking-wider text-slate-400 mb-1.5">Sign in with Email or Identity</label>
                        <input type="email" id="auth-email-input" placeholder="user@gmail.com" value="alex.owner@gracee.ai" class="w-full px-4 py-3 rounded-xl glass-input text-slate-100 text-sm focus:outline-none font-mono">
                    </div>

                    <button id="btn-execute-login" class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-slate-200 to-slate-400 text-slate-950 font-bold text-xs uppercase tracking-wider hover:opacity-90 transition-opacity shadow-lg flex items-center justify-center gap-2">
                        <i class="fa-solid fa-[#555] fa-shield-halved"></i>
                        <span>Authenticate & Launch Workspace</span>
                    </button>

                    <p class="text-[11px] text-slate-500 text-center leading-relaxed">
                        By logging in, you agree to GRACEE AI's security policies. Owner roles are securely validated server-side.
                    </p>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- 05 - 08. MAIN WORKSPACE (DASHBOARD)        -->
        <!-- ========================================== -->
        <div id="workspace-screen" class="relative w-full h-full flex flex-col md:flex-row flex-1 overflow-hidden opacity-0 transform scale-95 transition-all duration-700 pointer-events-none">
            
            <!-- MOBILE TOP BAR -->
            <header class="md:hidden glass-panel h-14 px-4 flex items-center justify-between z-20 border-b border-white/10">
                <button id="btn-mobile-sidebar-toggle" class="p-2 text-slate-300 hover:text-white">
                    <i class="fa-solid fa-bars-staggered text-lg"></i>
                </button>
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-brain text-slate-300 text-sm"></i>
                    <span class="font-light tracking-widest text-xs uppercase text-white">GRACEE <span class="font-bold">AI</span></span>
                </div>
                <button id="btn-mobile-new-chat" class="p-2 text-slate-300 hover:text-white">
                    <i class="fa-solid fa-pen-to-square text-base"></i>
                </button>
            </header>

            <!-- CUSTOM SIDEBAR -->
            <aside id="sidebar" class="fixed md:relative inset-y-0 left-0 z-30 w-72 glass-panel flex flex-col transform -translate-x-full md:translate-x-0 transition-transform duration-300 border-r border-white/10">
                
                <!-- Sidebar Header -->
                <div class="h-16 px-5 flex items-center justify-between border-b border-white/10">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg glass-card flex items-center justify-center border border-white/20">
                            <i class="fa-solid fa-brain text-slate-200 text-sm"></i>
                        </div>
                        <div>
                            <span class="font-light tracking-[0.2em] text-sm text-white uppercase block leading-none">GRACEE <span class="font-bold">AI</span></span>
                            <span class="text-[9px] text-slate-400 font-mono tracking-widest uppercase">Central Intelligence</span>
                        </div>
                    </div>
                    <button id="btn-close-sidebar" class="md:hidden p-1 text-slate-400 hover:text-white">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <!-- New Conversation Trigger -->
                <div class="p-4">
                    <button id="btn-new-chat" class="w-full py-3 px-4 rounded-xl glass-card text-slate-200 text-xs font-medium uppercase tracking-wider border border-white/10 hover:border-white/30 hover:bg-white/5 transition-all flex items-center justify-center gap-2 group">
                        <i class="fa-solid fa-plus text-slate-400 group-hover:text-white transition-colors"></i>
                        <span>New Conversation</span>
                    </button>
                </div>

                <!-- Navigation Tabs / Tools -->
                <div class="px-4 py-2 border-b border-white/5 space-y-1">
                    <button data-tab="chat" class="nav-tab-btn active w-full py-2.5 px-3 rounded-lg text-left text-xs text-slate-300 hover:bg-white/5 flex items-center gap-3 transition-colors">
                        <i class="fa-solid fa-comments text-slate-400 w-4 text-center"></i>
                        <span>Intelligence Chat</span>
                    </button>
                    <button data-tab="memory" class="nav-tab-btn w-full py-2.5 px-3 rounded-lg text-left text-xs text-slate-400 hover:text-slate-200 hover:bg-white/5 flex items-center gap-3 transition-colors">
                        <i class="fa-solid fa-microchip text-slate-400 w-4 text-center"></i>
                        <span>Memory Vault</span>
                    </button>
                    <button data-tab="settings" class="nav-tab-btn w-full py-2.5 px-3 rounded-lg text-left text-xs text-slate-400 hover:text-slate-200 hover:bg-white/5 flex items-center gap-3 transition-colors">
                        <i class="fa-solid fa-key text-slate-400 w-4 text-center"></i>
                        <span>API Configuration</span>
                    </button>
                    <button id="btn-owner-panel-trigger" class="w-full py-2.5 px-3 rounded-lg text-left text-xs text-amber-400/80 hover:text-amber-300 hover:bg-amber-500/10 flex items-center gap-3 transition-colors hidden">
                        <i class="fa-solid fa-crown text-amber-400 w-4 text-center"></i>
                        <span>Owner Control Panel</span>
                    </button>
                </div>

                <!-- Conversation History List -->
                <div class="flex-1 overflow-y-auto p-4 space-y-1">
                    <div class="text-[10px] font-mono uppercase tracking-widest text-slate-500 mb-2 px-2">History Log</div>
                    <div id="conversation-history-list" class="space-y-1">
                        <!-- History items populated dynamically -->
                    </div>
                </div>

                <!-- User Profile & Authentication State Footer -->
                <div class="p-4 border-t border-white/10 glass-panel">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3 overflow-hidden">
                            <div id="user-avatar" class="w-9 h-9 rounded-full bg-gradient-to-tr from-slate-700 to-slate-900 border border-white/20 flex items-center justify-center text-xs font-bold text-slate-200 shrink-0">
                                US
                            </div>
                            <div class="overflow-hidden">
                                <div id="user-display-name" class="text-xs font-medium text-slate-200 truncate">Guest Identity</div>
                                <div id="user-role-badge" class="text-[9px] font-mono text-slate-500 uppercase tracking-widest truncate">Standard User</div>
                            </div>
                        </div>
                        <button id="btn-logout" title="Sign Out" class="p-2 text-slate-400 hover:text-white transition-colors">
                            <i class="fa-solid fa-right-from-bracket"></i>
                        </button>
                    </div>
                </div>
            </aside>

            <!-- MAIN WORKSPACE CONTENT AREA -->
            <main class="flex-1 flex flex-col h-full bg-charcoal overflow-hidden relative">
                
                <!-- CHAT INTERFACE TAB -->
                <div id="tab-chat-content" class="workspace-tab flex-1 flex flex-col h-full overflow-hidden">
                    
                    <!-- Chat Header -->
                    <div class="h-14 px-6 glass-panel border-b border-white/5 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <h2 id="current-chat-title" class="text-sm font-medium text-slate-200">New Conversation</h2>
                            <span id="gemini-model-badge" class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">gemini-3-flash-preview</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <button id="btn-clear-chat" title="Clear Chat Messages" class="p-2 text-slate-400 hover:text-slate-200 transition-colors text-xs">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Messages Scroll Container -->
                    <div id="chat-messages-container" class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-6">
                        
                        <!-- Empty State Intro Card -->
                        <div id="empty-state" class="h-full flex flex-col items-center justify-center text-center px-4 max-w-2xl mx-auto space-y-6 my-auto py-12">
                            <div class="w-16 h-16 rounded-2xl glass-card flex items-center justify-center border border-white/10 shadow-xl animate-float">
                                <i class="fa-solid fa-sparkles text-2xl text-slate-200"></i>
                            </div>
                            <div>
                                <h3 class="text-xl font-light text-slate-100 tracking-wide mb-2">GRACEE AI Intelligence Hub</h3>
                                <p class="text-xs text-slate-400 leading-relaxed max-w-md mx-auto">
                                    Direct access to Google Gemini models with multi-modal reasoning, document analysis, voice synthesis, code debugging, and web search grounding.
                                </p>
                            </div>

                            <!-- Suggestion Quick Buttons -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 w-full text-left">
                                <button class="suggestion-btn glass-card p-3.5 rounded-xl border border-white/5 hover:border-white/20 text-xs text-slate-300 hover:text-white transition-all space-y-1">
                                    <div class="font-medium text-slate-200 flex items-center gap-2">
                                        <i class="fa-solid fa-code text-cyan-400"></i> Code Assistant
                                    </div>
                                    <div class="text-[11px] text-slate-500 truncate">Write an optimized Python script for async data fetching</div>
                                </button>
                                <button class="suggestion-btn glass-card p-3.5 rounded-xl border border-white/5 hover:border-white/20 text-xs text-slate-300 hover:text-white transition-all space-y-1">
                                    <div class="font-medium text-slate-200 flex items-center gap-2">
                                        <i class="fa-solid fa-globe text-purple-400"></i> Web Grounding
                                    </div>
                                    <div class="text-[11px] text-slate-500 truncate">Summarize the latest research advancements in quantum computing</div>
                                </button>
                            </div>
                        </div>

                    </div>

                    <!-- Composition Input Bar -->
                    <div class="p-4 sm:p-6 glass-panel border-t border-white/10">
                        <div class="max-w-4xl mx-auto space-y-2">
                            
                            <!-- File Attachment Preview Area -->
                            <div id="attachment-preview-container" class="hidden flex items-center gap-2 overflow-x-auto py-1">
                                <!-- Attachment chips rendered here -->
                            </div>

                            <!-- Main Input Container -->
                            <div class="relative glass-input rounded-2xl p-2 transition-all flex items-end gap-2 border border-white/15">
                                
                                <!-- File/Image Upload Trigger -->
                                <label for="file-upload-input" class="p-2.5 text-slate-400 hover:text-slate-200 cursor-pointer transition-colors rounded-xl hover:bg-white/5 flex items-center justify-center">
                                    <i class="fa-solid fa-paperclip text-sm"></i>
                                    <input type="file" id="file-upload-input" class="hidden" accept="image/*,.txt,.md,.js,.json,.python">
                                </label>

                                <!-- Textarea Input -->
                                <textarea id="chat-user-input" rows="1" placeholder="Instruct GRACEE AI..." class="w-full bg-transparent text-slate-100 text-sm focus:outline-none resize-none py-2 px-1 max-h-32 min-h-[38px] leading-relaxed"></textarea>

                                <!-- Speech Input Toggle -->
                                <button id="btn-voice-input" title="Voice Input" class="p-2.5 text-slate-400 hover:text-slate-200 transition-colors rounded-xl hover:bg-white/5 flex items-center justify-center">
                                    <i class="fa-solid fa-microphone text-sm"></i>
                                </button>

                                <!-- Submit Button -->
                                <button id="btn-send-message" class="p-2.5 bg-slate-200 hover:bg-white text-slate-950 rounded-xl transition-all font-bold flex items-center justify-center disabled:opacity-40">
                                    <i class="fa-solid fa-arrow-up text-sm"></i>
                                </button>
                            </div>

                            <!-- Context Controls Bar -->
                            <div class="flex items-center justify-between text-[11px] text-slate-500 px-1 font-mono">
                                <div class="flex items-center gap-3">
                                    <label class="flex items-center gap-1.5 cursor-pointer hover:text-slate-300">
                                        <input type="checkbox" id="toggle-search-grounding" class="rounded bg-charcoal border-white/20 text-cyan-500 focus:ring-0">
                                        <span>Google Search Grounding</span>
                                    </label>
                                </div>
                                <div class="text-[10px]">
                                    Press <kbd class="px-1 py-0.5 rounded bg-white/10 text-slate-300">Shift + Enter</kbd> for line break
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- MEMORY VAULT TAB -->
                <div id="tab-memory-content" class="workspace-tab flex-1 hidden p-6 overflow-y-auto max-w-4xl mx-auto w-full space-y-6">
                    <div>
                        <h2 class="text-xl font-light tracking-wide text-white mb-1">Persistent Memory System</h2>
                        <p class="text-xs text-slate-400">Manage user-approved contextual facts that GRACEE AI remembers across sessions.</p>
                    </div>

                    <div class="glass-card p-6 rounded-2xl border border-white/10 space-y-4">
                        <h3 class="text-xs font-mono uppercase text-slate-300 tracking-wider">Add Memory Directive</h3>
                        <div class="flex gap-2">
                            <input type="text" id="memory-input" placeholder="e.g. Always respond with concise code snippets using TypeScript." class="flex-1 px-4 py-2.5 rounded-xl glass-input text-xs text-slate-100 focus:outline-none">
                            <button id="btn-add-memory" class="px-5 py-2.5 rounded-xl bg-slate-200 text-slate-950 font-bold text-xs uppercase tracking-wider hover:bg-white transition-colors">
                                Add
                            </button>
                        </div>
                    </div>

                    <div class="glass-card p-6 rounded-2xl border border-white/10">
                        <h3 class="text-xs font-mono uppercase text-slate-300 tracking-wider mb-4">Saved Directive Notes</h3>
                        <div id="memory-list" class="space-y-2">
                            <!-- Memory notes listed here -->
                        </div>
                    </div>
                </div>

                <!-- API KEY SETTINGS TAB -->
                <div id="tab-settings-content" class="workspace-tab flex-1 hidden p-6 overflow-y-auto max-w-4xl mx-auto w-full space-y-6">
                    <div>
                        <h2 class="text-xl font-light tracking-wide text-white mb-1">Gemini Central Intelligence Key Settings</h2>
                        <p class="text-xs text-slate-400">Configure or override the official Google Gemini API Key securely.</p>
                    </div>

                    <div class="glass-card p-6 rounded-2xl border border-white/10 space-y-5">
                        <div>
                            <label class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-2">Gemini API Key</label>
