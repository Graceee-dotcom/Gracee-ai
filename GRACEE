            DOM.currentChatTitle.innerText = "New Conversation";
            
            // Add entry to conversation history list
            const historyItem = { id: AppState.currentChatId, title: "New Conversation", date: new Date().toLocaleDateString() };
            AppState.conversations.unshift(historyItem);
            renderConversationHistory();
        }

        function renderConversationHistory() {
            DOM.conversationHistoryList.innerHTML = AppState.conversations.map(c => `
                <button onclick="loadConversation('${c.id}')" class="w-full text-left p-2 rounded-lg text-xs text-slate-400 hover:text-slate-200 hover:bg-white/5 truncate transition-colors flex items-center justify-between group">
                    <span class="truncate"><i class="fa-regular fa-message mr-2 text-slate-500"></i>${c.title}</span>
                </button>
            `).join('');
        }

        function clearCurrentChat() {
            AppState.messages = [];
            DOM.chatMessagesContainer.innerHTML = '';
            DOM.chatMessagesContainer.appendChild(DOM.emptyState);
            DOM.emptyState.classList.remove('hidden');
        }

        /* ==================================================== */
        /* ATTACHMENT & VOICE ENGINE HANDLERS                   */
        /* ==================================================== */
        function handleFileUpload(e) {
            const files = e.target.files;
            if (!files.length) return;

            Array.from(files).forEach(file => {
                const reader = new FileReader();
                if (file.type.startsWith('image/')) {
                    reader.onload = (evt) => {
                        const base64 = evt.target.result.split(',')[1];
                        AppState.attachments.push({ name: file.name, mimeType: file.type, base64: base64 });
                        renderAttachmentPreviews();
                    };
                    reader.readAsDataURL(file);
                } else {
                    reader.onload = (evt) => {
                        AppState.attachments.push({ name: file.name, mimeType: file.type, textData: evt.target.result });
                        renderAttachmentPreviews();
                    };
                    reader.readAsText(file);
                }
            });
        }

        function renderAttachmentPreviews() {
            const container = DOM.attachmentPreviewContainer;
            if (AppState.attachments.length === 0) {
                container.classList.add('hidden');
                container.innerHTML = '';
                return;
            }

            container.classList.remove('hidden');
            container.innerHTML = AppState.attachments.map((att, idx) => `
                <div class="px-2.5 py-1 rounded-lg glass-card border border-white/10 text-[11px] text-slate-300 flex items-center gap-2">
                    <i class="fa-solid fa-file font-mono text-cyan-400"></i>
                    <span class="truncate max-w-[120px]">${att.name}</span>
                    <button onclick="removeAttachment(${idx})" class="text-slate-500 hover:text-slate-200">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
            `).join('');
        }

        window.removeAttachment = function(index) {
            AppState.attachments.splice(index, 1);
            renderAttachmentPreviews();
        };

        function initSpeechRecognition() {
            if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
                const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
                AppState.speechRecognition = new SpeechRecognition();
                AppState.speechRecognition.continuous = false;
                AppState.speechRecognition.interimResults = false;

                AppState.speechRecognition.onresult = (event) => {
                    const transcript = event.results[0][0].transcript;
                    DOM.chatUserInput.value += (DOM.chatUserInput.value ? ' ' : '') + transcript;
                    DOM.btnVoiceInput.classList.remove('text-red-400', 'animate-pulse');
                    AppState.isRecording = false;
                };

                AppState.speechRecognition.onerror = () => {
                    DOM.btnVoiceInput.classList.remove('text-red-400', 'animate-pulse');
                    AppState.isRecording = false;
                };
            }
        }

        function toggleVoiceRecognition() {
            if (!AppState.speechRecognition) {
                showNotification("Speech recognition is not supported in this browser.");
                return;
            }

            if (AppState.isRecording) {
                AppState.speechRecognition.stop();
                DOM.btnVoiceInput.classList.remove('text-red-400', 'animate-pulse');
                AppState.isRecording = false;
            } else {
                AppState.speechRecognition.start();
                DOM.btnVoiceInput.classList.add('text-red-400', 'animate-pulse');
                AppState.isRecording = true;
            }
        }

        /* ==================================================== */
        /* MEMORY & OWNER PANEL RENDERING                       */
        /* ==================================================== */
        function renderMemoryList() {
            DOM.memoryList.innerHTML = AppState.memoryNotes.map((note, idx) => `
                <div class="p-3 rounded-xl glass-card border border-white/5 flex items-center justify-between text-xs text-slate-300">
                    <span>${escapeHTML(note)}</span>
                    <button onclick="deleteMemory(${idx})" class="text-slate-500 hover:text-red-400 transition-colors">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </div>
            `).join('');
        }

        window.deleteMemory = function(idx) {
            AppState.memoryNotes.splice(idx, 1);
            renderMemoryList();
            showNotification("Directive removed.");
        };

        function renderOwnerUserTable() {
            const users = [
                { email: AppState.ownerEmail, role: 'owner', joined: '2026-01-15', status: 'Active' },
                { email: 'sarah.dev@gracee.ai', role: 'user', joined: '2026-02-10', status: 'Active' },
                { email: 'marcus.research@gracee.ai', role: 'user', joined: '2026-02-28', status: 'Active' },
                { email: 'guest.demo@gracee.ai', role: 'user', joined: '2026-03-01', status: 'Limited' }
            ];

            DOM.ownerUserTableBody.innerHTML = users.map(u => `
                <tr class="hover:bg-white/5 transition-colors">
                    <td class="py-3 text-slate-200">${u.email}</td>
                    <td class="py-3">
                        <span class="px-2 py-0.5 rounded text-[9px] uppercase ${u.role === 'owner' ? 'bg-amber-500/20 text-amber-300 border border-amber-500/30' : 'bg-slate-700 text-slate-300'}">
                            ${u.role}
                        </span>
                    </td>
                    <td class="py-3 text-slate-400">${u.joined}</td>
                    <td class="py-3"><span class="text-emerald-400">${u.status}</span></td>
                </tr>
            `).join('');
        }

        // Helper Notifications & Utilities
        function showNotification(msg) {
            const toast = document.createElement('div');
            toast.className = 'fixed bottom-6 right-6 z-50 glass-panel px-4 py-3 rounded-xl border border-white/20 text-xs text-slate-200 shadow-2xl flex items-center gap-2 transform translate-y-4 opacity-0 transition-all duration-300';
            toast.innerHTML = `<i class="fa-solid fa-circle-info text-cyan-400"></i><span>${msg}</span>`;
            document.body.appendChild(toast);

            setTimeout(() => toast.classList.remove('translate-y-4', 'opacity-0'), 10);
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-4');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        function escapeHTML(str) {
            return str.replace(/[&<>'"]/g, 
                tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
            );
        }
    </script>
</body>
